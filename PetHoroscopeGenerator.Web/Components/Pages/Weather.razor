@page "/weather"
@using PetHoroscopeGenerator.Web.Clients
@inject WeatherApiClient WeatherApiClient
@attribute [StreamRendering]
@attribute [OutputCache(Duration = 60)]

<PageTitle>Weather Forecast</PageTitle>

<h1>Weather Forecast</h1>

<p>This component demonstrates showing data loaded from a backend API service. Use the search below to filter results.</p>

<p>
    <label>
        Filter by summary:
        <input @bind="searchTerm" @bind:event="oninput" />
    </label>
</p>

@if (forecasts is null)
{
    <p><em>Loading forecast... please wait.</em></p>
}
else
{
    <!-- Display forecasts in a grid -->
    <table class="table table-striped">
        <thead>
            <tr>
                <th>Date</th>
                <th>Temp. (K)</th>
                <th>Summary</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var forecast in FilteredForecasts)
            {
                <tr>
                    <td>@forecast.Date.ToShortDateString()</td>
                    <td>@(forecast.TemperatureC + 273.15)</td>
                    <td>@forecast.Summary</td>
                </tr>
            }
        </tbody>
    </table>
}

@code {
    private WeatherForecast[]? forecasts;
    private string? searchTerm;

    private IEnumerable<WeatherForecast> FilteredForecasts =>
        forecasts?.Where(f => string.IsNullOrWhiteSpace(searchTerm) || f.Summary?.Contains(searchTerm, StringComparison.OrdinalIgnoreCase) == true) ?? Enumerable.Empty<WeatherForecast>();

    protected override async Task OnInitializedAsync()
    {
        // Artificial delay for demonstration
        await Task.Delay(500);
        forecasts = await WeatherApiClient.GetWeatherAsync();
    }
}
